NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/natraj_mobile
# Optional Atlas non-SRV fallback for networks where Node cannot resolve SRV records:
# MONGODB_HOSTS=host-00.mongodb.net:27017,host-01.mongodb.net:27017,host-02.mongodb.net:27017
# MONGODB_REPLICA_SET=atlas-example-shard-0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
ADMIN_NAME=Natraj Administrator
ADMIN_EMAIL=admin@natrajmobile.example
ADMIN_PASSWORD=replace-with-a-strong-password
SUPER_ADMIN_NAME=Natraj Super Administrator
SUPER_ADMIN_EMAIL=superadmin@natrajmobile.example
SUPER_ADMIN_PASSWORD=replace-with-a-different-strong-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Natraj Mobile & Electronics <no-reply@natrajmobile.example>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
